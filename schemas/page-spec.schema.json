{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-ops.local/schemas/page-spec.schema.json",
  "title": "PPT-Ops Page Spec",
  "description": "Shared semantic page contract consumed by every renderer.",
  "type": "object",
  "required": ["page", "task", "three_second_message", "relation", "screen_text", "visual_job", "asset_slots", "status"],
  "properties": {
    "diagram": {"$ref": "diagram.schema.json"},
    "design_system_layout_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "page": { "type": "integer", "minimum": 1 },
    "source": { "type": "string", "minLength": 1, "description": "Project-relative source file, optionally followed by a #fragment." },
    "task": { "type": "string", "minLength": 1 },
    "three_second_message": { "type": "string", "minLength": 1 },
    "relation": { "type": "string", "enum": ["sequence", "parallel", "cause_effect", "before_after", "hierarchy", "process", "cycle", "comparison", "hero"] },
    "screen_text": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "body": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "visual_job": { "type": "string", "minLength": 1 },
    "estimated_duration_seconds": { "type": "integer", "minimum": 1, "description": "Planning estimate only; not evidence of rehearsed timing." },
    "speaker_notes": { "type": "string", "minLength": 1, "description": "Authored off-slide speaker notes. Never visible slide copy." },
    "delivery_feedback": { "$ref": "delivery-feedback.schema.json" },
    "script_role": {"type": "string", "enum": ["transition", "core", "reference"], "description": "Script budget role: transition is one sentence, core is prioritized, reference is compressible or skippable. Defaults to core."},
    "merged_with": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}]}, "description": "Pages (number or PageSpec id) whose narration is carried by this page's speaker_notes."},
    "speaker_note_intent": { "type": "string", "minLength": 1, "description": "Purpose of off-slide speaker support; never visible slide copy." },
    "audience_interaction": {
      "type": "object",
      "required": ["kind", "intent"],
      "properties": {
        "kind": { "type": "string", "enum": ["audience_action", "question", "exercise", "demonstration", "feedback"] },
        "intent": { "type": "string", "minLength": 1 },
        "expected_response": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "asset_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "asset_id"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "asset_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "fit": { "type": "string", "enum": ["cover", "contain"] },
          "evidence_purpose": { "type": "string", "minLength": 1, "description": "Optional page-specific purpose when the same screenshot supports a different claim on this page." },
          "region_mappings": { "type": "array", "items": { "type": "object", "required": ["content_id", "region_id"], "properties": { "content_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }, "region_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }, "anchor_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }, "label": { "type": "string", "minLength": 1, "maxLength": 80 } }, "additionalProperties": false } }
        },
        "additionalProperties": false
      }
    },
    "status": { "type": "string", "enum": ["draft", "prototype", "approved", "built", "reviewed"] },
    "html": { "type": "object" },
    "pptx": { "type": "object" }
  },
  "additionalProperties": false
}
