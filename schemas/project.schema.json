{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-ops.local/schemas/project.schema.json",
  "title": "PPT-Ops Project Manifest",
  "type": "object",
  "required": ["schema_version", "name", "title", "format", "source_files", "theme_file", "assets_file", "outputs"],
  "properties": {
    "design_system_pack_file": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "schema_version": { "enum": ["0.1", "1.0"] },
    "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "format": { "const": "16:9" },
    "source_files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "theme_file": { "type": "string", "minLength": 1 },
    "assets_file": { "type": "string", "minLength": 1 },
    "delivery_mode": { "type": "string", "enum": ["live_talk", "workshop", "pitch", "leave_behind", "async", "online_lecture"] },
    "safe_zones": {
      "type": "array",
      "description": "Screen-share occlusion zones for online_lecture, as presets or normalized 0..1 rectangles of the 16:9 slide.",
      "items": {
        "oneOf": [
          { "type": "object", "required": ["preset"], "properties": { "preset": { "enum": ["tencent_meeting", "zoom", "feishu", "replay_captions"] } }, "additionalProperties": false },
          {
            "type": "object", "required": ["name", "x", "y", "width", "height"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
              "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "description": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "interaction_interval_minutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 60, "description": "online_lecture: maximum estimated minutes between audience_interaction pages (default 8)." },
    "talk_budget": {"type": "object", "required": ["total_minutes"], "properties": {"total_minutes": {"type": "number", "exclusiveMinimum": 0}, "words_per_minute": {"type": "number", "exclusiveMinimum": 0, "default": 250, "description": "Spoken words per minute. Each CJK character counts as one word; each Latin word or number counts as one word."}, "reserve_minutes": {"type": "number", "minimum": 0, "description": "Q&A or buffer time excluded from the spoken budget; must be less than total_minutes."}, "tolerance_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100, "default": 10}}, "additionalProperties": false, "description": "Optional total talk-time budget for speaker scripts. Absent means no budget review."},
    "script_review": {"type": "object", "properties": {"banned_phrases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Replaces the default list (说白了, 简单来说, 换句话说, 综上所述, 总而言之, 众所周知). An empty array disables the check."}, "max_dashes_per_page": {"type": "integer", "minimum": 0, "default": 2}, "quote_style": {"type": "string", "enum": ["consistent", "curly", "corner"], "default": "consistent"}}, "additionalProperties": false, "description": "Optional speaker script language checks."},
    "outputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["html", "pptx", "pdf", "png"] } }
  },
  "additionalProperties": false
}
