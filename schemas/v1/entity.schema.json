{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-ops.local/schemas/v1/entity.schema.json",
  "title": "PPT-Ops V1 Entity",
  "type": "object",
  "required": ["contract_version", "kind", "id"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "kind": { "enum": ["project", "source", "outline", "page_spec", "theme", "template", "asset", "candidate", "candidate_feedback", "powerpoint_observation", "approval", "version", "build", "review", "handoff"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
  }
}
