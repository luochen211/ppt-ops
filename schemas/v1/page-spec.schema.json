{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-ops.local/schemas/v1/page-spec.schema.json",
  "title": "V1 Page Spec",
  "allOf": [
    {
      "$ref": "entity.schema.json"
    },
    {
      "type": "object",
      "required": [
        "page",
        "task",
        "three_second_message",
        "relation",
        "screen_text",
        "visual_job",
        "source_refs",
        "asset_slots",
        "content_status",
        "renderers"
      ],
      "properties": {
        "diagram": { "$ref": "../diagram.schema.json" },
        "kind": {
          "const": "page_spec"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "asset_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidence_purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "estimated_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Planning estimate only; not evidence of rehearsed timing."
        },
        "speaker_notes": { "type": "string", "minLength": 1, "description": "Authored off-slide speaker notes. Never visible slide copy." },
        "speaker_note_intent": {
          "type": "string",
          "minLength": 1,
          "description": "Purpose of off-slide speaker support; never visible slide copy."
        },
        "audience_interaction": {
          "type": "object",
          "required": [
            "kind",
            "intent"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "audience_action",
                "question",
                "exercise",
                "demonstration",
                "feedback"
              ]
            },
            "intent": {
              "type": "string",
              "minLength": 1
            },
            "expected_response": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "accessibility": {
          "type": "object",
          "properties": {
            "language": { "type": "string", "minLength": 1 },
            "reading_order": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "links": { "type": "array", "items": { "type": "object", "required": ["label", "destination"], "properties": { "label": { "type": "string", "minLength": 1 }, "destination": { "type": "string", "minLength": 1 } } } },
            "charts": { "type": "array", "items": { "type": "object" } },
            "tables": { "type": "array", "items": { "type": "object" } },
            "meaning_dependencies": { "type": "array", "items": { "type": "string" } },
            "text_on_image": { "type": "boolean" },
            "contrast_samples": { "type": "array", "items": { "type": "object", "required": ["foreground", "background", "role"], "properties": { "foreground": { "type": "string" }, "background": { "type": "string" }, "role": { "type": "string" }, "minimum": { "type": "number", "minimum": 1, "maximum": 21 } } } }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
