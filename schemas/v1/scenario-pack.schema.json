{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-ops.local/schemas/v1/scenario-pack.schema.json",
  "title": "V1 Scenario Pack",
  "type": "object",
  "required": ["contract_version", "kind", "id", "name", "domain", "workplace_context", "scenarios"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "kind": { "const": "scenario_pack" },
    "id": { "type": "string", "pattern": "^scenario-pack-[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "domain": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "workplace_context": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["id", "title", "learning_objective_id", "personas", "observable_cues", "decision_points", "plausible_distractors", "expected_action", "rationale", "facilitation_question", "difficulty", "ambiguity", "visual_brief", "accessibility_description", "claims", "decision_state"],
      "properties": {
        "id": { "type": "string", "pattern": "^scenario-[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "learning_objective_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "personas": { "type": "array", "minItems": 1 },
        "observable_cues": { "type": "array", "minItems": 1 },
        "decision_points": { "type": "array", "minItems": 1 },
        "plausible_distractors": { "type": "array", "minItems": 1 },
        "expected_action": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "rationale": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "facilitation_question": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "difficulty": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "ambiguity": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "visual_brief": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "accessibility_description": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "decision_state": { "enum": ["proposed", "accepted", "rejected"] },
        "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "text", "evidence_kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "evidence_kind": { "enum": ["sourced_fact", "regulatory_requirement", "instructional_fiction"] },
        "source_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "jurisdiction": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "human_confirmation": { "enum": ["required", "confirmed"] }
      },
      "allOf": [
        {
          "if": { "properties": { "evidence_kind": { "const": "sourced_fact" } } },
          "then": { "required": ["source_id"] }
        },
        {
          "if": { "properties": { "evidence_kind": { "const": "regulatory_requirement" } } },
          "then": { "required": ["source_id", "jurisdiction", "human_confirmation"] }
        },
        {
          "if": { "properties": { "evidence_kind": { "const": "instructional_fiction" } } },
          "then": { "not": { "anyOf": [{ "required": ["source_id"] }, { "required": ["jurisdiction"] }] } }
        }
      ]
    }
  }
}

