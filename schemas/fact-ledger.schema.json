{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-ops.local/schemas/fact-ledger.schema.json",
  "title": "PPT-Ops fact provenance ledger",
  "description": "Durable, claim-level source, validity and Page Spec binding records. Expiry means revalidation is due, not that a claim is false.",
  "type": "object",
  "required": ["schema_version", "project_id", "claims"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project_id": { "$ref": "#/$defs/id" },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "instant": { "type": "string", "format": "date-time" },
    "claim": {
      "type": "object",
      "required": ["id", "revision", "statement", "statement_sha256", "kind", "status", "validity", "sources", "bindings"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "statement_sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "type": "string", "enum": ["timeless", "time_sensitive", "forecast", "quotation", "derived", "organization_assertion"] },
        "status": { "type": "string", "enum": ["supported", "unverified", "conflicted", "superseded", "withdrawn", "unable_to_verify"] },
        "validity": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "type": "string", "enum": ["timeless", "unknown", "date", "review", "event", "version"] },
            "verified_at": { "$ref": "#/$defs/instant" },
            "valid_until": { "$ref": "#/$defs/instant" },
            "review_after": { "$ref": "#/$defs/instant" },
            "event": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "locator", "source_sha256"],
            "properties": {
              "source_id": { "$ref": "#/$defs/id" },
              "locator": { "type": "string", "minLength": 1 },
              "source_sha256": { "$ref": "#/$defs/sha256" },
              "evidence_sha256": { "$ref": "#/$defs/sha256" },
              "extraction_revision": { "type": "string", "minLength": 1 },
              "accessed_at": { "$ref": "#/$defs/instant" },
              "verified_at": { "$ref": "#/$defs/instant" }
            },
            "additionalProperties": false
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["page_id", "field"],
            "properties": {
              "page_id": { "$ref": "#/$defs/id" },
              "field": { "type": "string", "pattern": "^/" },
              "fragment": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "verification": {
          "type": "object",
          "required": ["actor", "method", "verified_at"],
          "properties": {
            "actor": { "type": "string", "minLength": 1 },
            "method": { "type": "string", "minLength": 1 },
            "verified_at": { "$ref": "#/$defs/instant" }
          },
          "additionalProperties": false
        },
        "derivation": {
          "type": "object",
          "required": ["claim_ids", "method"],
          "properties": {
            "claim_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
            "method": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "superseded_by": { "$ref": "#/$defs/id" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
